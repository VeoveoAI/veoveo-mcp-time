{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    tenant AS \"tenant: TenantId\",\n    epoch_key AS \"epoch_key: EpochId\",\n    epoch_version,\n    owner AS \"owner: PrincipalId\",\n    name,\n    tai_seconds_since_1970,\n    nanosecond,\n    body,\n    created_at,\n    updated_at,\n    tenant_key,\n    owner_key,\n    work_context\nFROM time.epoch\nWHERE tenant = $1\n    AND (\n        $2::text IS NULL\n        OR epoch_key > $2\n        OR (epoch_key = $2 AND epoch_version < $3)\n    )\nORDER BY epoch_key, epoch_version DESC\nLIMIT $4\n",
