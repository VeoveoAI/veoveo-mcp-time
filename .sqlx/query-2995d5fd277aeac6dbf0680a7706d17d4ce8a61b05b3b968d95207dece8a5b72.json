  "db_name": "PostgreSQL",
  "query": "-- The first rows of a tenant's calendar versions: key ascending, then the newest version.\nSELECT\n    tenant AS \"tenant: TenantId\",\n    calendar_key AS \"calendar_key: CalendarId\",\n    calendar_version,\n    owner AS \"owner: PrincipalId\",\n    name,\n    zone_id,\n    state AS \"state: TimeCalendarState\",\n    body,\n    created_at,\n    updated_at,\n    tenant_key,\n    owner_key\nFROM time.calendar_version\nWHERE tenant = $1\nORDER BY calendar_key, calendar_version DESC\nLIMIT $2\n",
